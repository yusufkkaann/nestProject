# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/media_library?retryWrites=true&w=majority

# JWT secrets (openssl rand -base64 48 ile uretin)
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# File storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Server
PORT=3000
NODE_ENV=development
